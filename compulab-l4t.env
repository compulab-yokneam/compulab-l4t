# EV
export export ARCH=arm64
export L4T_ROOT=$(readlink -e .)
export L4T_TMP=${L4T_ROOT}/tmp
export ROOTFS=$(readlink -e rootfs)
export INSTALL_MOD_PATH=${ROOTFS}
export SOURCE=$(readlink -e source)
# Cross
# r36.4.x
export KERNEL_HEADERS=$(readlink -e source/kernel/kernel-jammy-src)
export CROSS_COMPILE=/opt/aarch64--glibc--stable-2022.08-1/bin/aarch64-buildroot-linux-gnu-
export L4T_KERNEL_VER_NVIDIA="5.15.148-tegra"
export L4T_KERNEL_VER=${L4T_KERNEL_VER_NVIDIA}
# r38.2.x
# export KERNEL_HEADERS=$(readlink -e source/kernel/kernel-noble)
# export CROSS_COMPILE=/opt/aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-
# export L4T_KERNEL_VER="6.8.XXX-tegra"

export EDGE_AI=${EDGE_AI:-"edge-ai"}
export K_OPT="-C kernel"
export M_OPT="modules"
export T_OPT="dtbs"
# chroot tools
export QEMU="/usr/bin/qemu-aarch64-static"
declare -A mounto=([proc]='-t proc proc' [sys]='-t sysfs sys' [dev]='-t devtmpfs dev' [dev/pts]='-t devpts devpts')
# recovery shell
MFI_BOOTLOADER="${L4T_ROOT}/mfi_${EDGE_AI}/bootloader"
declare -xi NVIDIA_DEVS=0
# Backup/restore
RES_BOOTLOADER="${L4T_ROOT}/tools/backup_restore/images/QSPI0.img"
# CompuLab rootfs services
export rootfs_service="compulab-rootfs-update"

function issue_chroot_init() {
    for d in ${!mounto[@]}; do
        sudo mount ${mounto[$d]} ${root_fs}/${d}
    done
    sudo cp ${QEMU} ${root_fs}${QEMU}
}

function issue_chroot_fini() {
    local busy_mount=""
    for d in ${!mounto[@]}; do
        sudo umount ${root_fs}/${d} 2>/dev/null || busy_mount+=" ${d}"
    done
    for d in ${busy_mount}; do
        sudo umount -l ${root_fs}/${d} || true
    done
    sudo rm -rf ${root_fs}${QEMU}
}

function issue_chroot_main() {

local root_home=""
local tty=$(tty)
local chroot_hostname=$(cat ${root_fs}/etc/hostname)

[[ -d ${root_fs}/root ]] && root_home=/root
[[ -d ${root_fs}/home/root ]] && root_home=/home/root
root_home=${root_home:-/}

local chroot_home=/tmp/root
local chroot_bashrc=${chroot_home}/.bashrc.chroot
local chroot_histfile=${chroot_home}/.bash_history_chroot
sudo mkdir -p ${root_fs}/${chroot_home}

sudo [ -f ${root_fs}/${root_home}/.bashrc ]
if [ $? -eq 0 ];then
sudo cp ${root_fs}/${root_home}/.bashrc ${root_fs}/${chroot_bashrc}
fi

cat << eof | sudo tee -a ${root_fs}/${chroot_bashrc} &>/dev/null
alias ?="echo tty: ${tty}; echo rootfs: ${root_fs};"
export HOME=${root_home}
HISTFILE=${chroot_histfile}
HOSTNAME="nvidia-rootfs"
debian_chroot="chroot"
debian_hostname="nvidia-rootfs"
PS1='\${debian_chroot:+(\$debian_chroot)}\u@\${debian_hostname}:\w\$ \n \l \j # '
rm -rf "${chroot_bashrc}"
shopt -s checkwinsize ; resize ; clear
bind 'set show-mode-in-prompt on'
set -o vi
eof

local chroot_options="--rcfile ${chroot_bashrc}"
local chroot_shell="/bin/bash"
local chroot_command=${chroot_command:-${chroot_shell} ${chroot_options}}

sudo chroot ${root_fs} ${chroot_command}

}

customize_rootfs() {
    [[ -z ${ROOTFS:-""} ]] && return 0 || true
    root_fs=${ROOTFS} issue_chroot_init
    root_fs=${ROOTFS} issue_chroot_main
    root_fs=${ROOTFS} issue_chroot_fini
}

update_initrd() {
    chroot_command="nv-update-initrd" customize_rootfs
}

pre_install_update() {
    chmod a+x ${L4T_ROOT}/compulab.d/scripts/pre_install.sh
    sudo mount -o ro -B ${L4T_ROOT}/compulab.d ${ROOTFS}/media
    chroot_command="/media/scripts/pre_install.sh" customize_rootfs
    sudo umount -l ${ROOTFS}/media
}
update_rootfs() { pre_install_update; }

post_install_update() {
    local kernel_version=$(cat ${KERNEL_HEADERS}/include/config/kernel.release)
    chmod a+x ${L4T_ROOT}/compulab.d/scripts/post_install.sh
    sudo mount -o ro -B ${L4T_ROOT}/compulab.d ${ROOTFS}/media
    chroot_command="/media/scripts/post_install.sh ${kernel_version} ${L4T_KERNEL_VER_NVIDIA} ${rootfs_service}" customize_rootfs
    sudo umount -l ${ROOTFS}/media
}

do_it_all() {
    compile_all
    install_all
    post_install_update
}

__compile_1() {
    export KBUILD_BUILD_USER="compulab"
    export KBUILD_BUILD_HOST="compulab"
    pushd ${SOURCE}
    make -j 16 $@
    popd
}

__compile_k() {
    __compile_1 ${K_OPT}
    export L4T_KERNEL_VER=$(cat ${KERNEL_HEADERS}/include/config/kernel.release)
}

__compiled_k_version() {
    [[ -f ${KERNEL_HEADERS}/include/config/kernel.release ]] && cat ${KERNEL_HEADERS}/include/config/kernel.release || echo -n "?"
}

__compile_m() {
    __compile_1 ${M_OPT}
}

__compile_t() {
    __compile_1 ${T_OPT}
}

compile_all() {
    __compile_k
    __compile_m
    __compile_t
}

alias ~k="__compile_k"
alias ~m="__compile_m"
alias ~t="__compile_t"
alias ~a="compile_all"

__install_k() {
    pushd ${SOURCE}
    sudo -E make install ${K_OPT}
    sudo cp -v ${KERNEL_HEADERS}/arch/arm64/boot/Image ${INSTALL_MOD_PATH}/boot/
    popd
}

__install_m() {
    pushd ${SOURCE}
    sudo -E make modules_install
    popd
}

__install_t() {
    pushd ${SOURCE}
    sudo rm -rf ${INSTALL_MOD_PATH}/boot/dtbs
    sudo mkdir -p ${INSTALL_MOD_PATH}/boot/dtbs
    sudo fakeroot cp -va kernel-devicetree/generic-dts/dtbs/*-nv-super*.dtb  ${INSTALL_MOD_PATH}/boot/dtbs/
    popd
}

__install_t1() {
    pushd ${SOURCE}
    sudo rm -rf ${L4T_ROOT}/kernel/dtb/*.*
    sudo cp -va kernel-devicetree/generic-dts/dtbs/* ${L4T_ROOT}/kernel/dtb/
    popd
}

__update_rootfs() {
    [[ -d ${L4T_ROOT}/compulab.d/rootfs ]] || return 0
    tar -C ${L4T_ROOT}/compulab.d/rootfs --owner=0 --group=0 --numeric-owner -cvf - . | sudo fakeroot tar -C ${L4T_ROOT}/rootfs --keep-directory-symlink --numeric-owner -xvf -
}

install_all() {
    __install_k
    __install_m
    __install_t
    __install_t1
    __update_rootfs
}

alias ~ik="__install_k"
alias ~im="__install_m"
alias ~it="__install_t"
alias ~it1="__install_t1"
alias ~ia="install_all"

busy_wait() {
    read -p "Press any key ..."
}

_br_rootfs_bootloader() {
    [[ -n ${1:-""} ]] || return 0
    pushd ${L4T_ROOT}
    sudo ./tools/backup_restore/l4t_backup_restore.sh ${1} ${EDGE_AI}
    popd
}

restore_rootfs_bootloader() {
    _br_rootfs_bootloader "-r"
}

backup_rootfs_bootloader() {
    _br_rootfs_bootloader "-b"
}

bootloader_bootorder() {
    cp -v ${L4T_ROOT}/compulab.d/bootloader/L4TConfiguration.dtbo ${L4T_ROOT}/bootloader/
}

export UEFI_FILE="uefi_jetson.bin"
export UEFI_FOLDER="$(pwd)/bootloader/"
export UEFI_BOOTLOADER="${UEFI_FOLDER}/${UEFI_FILE}"
export UEFI_LOGO="${UEFI_FOLDER}/UEFI/36.4.3/logo/${UEFI_FILE}"
export UEFI_NOLOGO="${UEFI_FOLDER}/UEFI/36.4.3/nologo/${UEFI_FILE}"

current_bootloader() {
    [[ -f ${UEFI_LOGO} ]] && {
        diff ${UEFI_BOOTLOADER} ${UEFI_LOGO} &>/dev/null
        if [ $? -eq 0 ];then
            echo "logo"
            return 0
        fi
    } || true
    [[ -f ${UEFI_NOLOGO} ]] && {
        diff ${UEFI_BOOTLOADER} ${UEFI_NOLOGO} &>/dev/null
        if [ $? -eq 0 ];then
            echo "nologo"
            return 0
        fi
    } || true
    echo "unk"
    return 0
}

select_bootloader() {
    declare -A bootloaders=( ['logo']=${UEFI_LOGO} ['nologo']=${UEFI_NOLOGO} )
    bl_type=${bl_type:-"empty"}
    if [ -z ${bootloaders[${bl_type}]:-""} ];then
    local select_string=$(echo -n ${!bootloaders[@]} | tr ' ' '\n' | sort -n | tr '\n' ' ')
    PS3="Booltoader > "
    select j in ${select_string}; do
        case ${j} in
        "")
            break
            ;;
        *)
            bl_type=${j}
            break
            ;;
        esac
    done
    fi
local cmd_file_name=/tmp/${FUNCNAME}_${bl_type}
cat << eof | tee ${cmd_file_name}
    cp -v ${bootloaders[${bl_type}]} ${UEFI_BOOTLOADER}
eof
    source ${cmd_file_name}
    unset bl_type
}

# Available devices
export BOARDID="3767"
export BOARDSKU="-1"
# 0 - NX16; 1 - NX8; 3 - NA4; 4 - NA8
export FAB="TS4"
export DEVICE_OPTIONS=""
declare -xA nvidia_dev_names=([0]='NX16' [1]='NX8' [3]='NA4' [4]='NA8')
declare -xA nvidia_devices=([NX16]='0' [NX8]='1' [NA4]='3' [NA8]='4')

current_device() {
    echo ${nvidia_dev_names[${BOARDSKU}]:-"discoverable"}
    return 0
}

select_config() {
    local _config=""
    read -p "Please type config name: # " _config
    if [[ -f ${L4T_ROOT}/${_config}.conf ]];then
        EDGE_AI=${_config}
        return 0
    fi
cat << eof
    Error ${L4T_ROOT}/${_config}.conf is not found ...
eof
    return 1
}

select_device() {
    dev_type=${dev_type:-"empty"}
    if [ -z ${nvidia_devices[${dev_type}]:-""} ];then
    local select_string=$(echo -n ${!nvidia_devices[@]}" device")
    PS3="NVidia Device > "
    select j in ${select_string}; do
        case ${j} in
        "device")
            export BOARDSKU="-1"
            export DEVICE_OPTIONS=""
            return 0
            break
            ;;
        *)
            dev_type=${j}
            break
            ;;
        esac
    done
    fi
local cmd_file_name=/tmp/${FUNCNAME}_${dev_type}
cat << eof | tee ${cmd_file_name}
export BOARDSKU="${nvidia_devices[${dev_type}]}"
export DEVICE_OPTIONS="BOARDID=${BOARDID} BOARDSKU=000\${BOARDSKU} FAB=${FAB}"
eof
    source ${cmd_file_name}
    unset dev_type
}

export L4T_WORKDIR=${L4T_ROOT}/workdir
export L4T_IMAGEDIR=${L4T_WORKDIR}/images.d
export L4T_PCDIR=${L4T_WORKDIR}/partclone.d
export L4T_IMAGE=""

export LOOP_DEV_SIZE_GB=32
_create_disk_image_init() {
    local size=${size:-${LOOP_DEV_SIZE_GB}}
    local image_file_name=${L4T_IMAGE:-""}
    if [[ -z ${image_file_name:-""} ]];then
        image_file_name=${L4T_IMAGEDIR}/$(date +%Y-%m-%d_%T | tr ":" "-")/${size}g.img
        mkdir -p $(dirname ${image_file_name})
        truncate -s ${size}G ${image_file_name}
    fi
    local loop_device=$(sudo losetup --show --find --partscan ${image_file_name} 2>/dev/null) && rc=$? || rc=$?
    echo ${loop_device}
    [[ -n ${loop_device:-""} ]] && true || false
}

_create_disk_image_fini() {
    sudo losetup --detach ${loop_device}
    return 0
}

_create_disk_image_proc() {
    local cmd_file_name=/tmp/${FUNCNAME}
    pushd ${L4T_ROOT}
    sudo EXT_NUM_SECTORS=$(( $(( ${LOOP_DEV_SIZE_GB} -2 )) << 21 )) BOARDID=3767 BOARDSKU=0000 FAB=TS4 ./tools/kernel_flash/l4t_initrd_flash.sh \
    -c tools/kernel_flash/flash_l4t_t234_nvme.xml \
    --external-device nvme0n1p1 -S $((${LOOP_DEV_SIZE_GB} - 8 ))GiB --direct ${DIRECT_DEVICE} edge-ai external

    popd
}

create_disk_image_func() {
    local loop_device=$(_create_disk_image_init) && rc=$? || rc=$?
    if [[ -z ${loop_device:-""} ]];then
cat << eof
    Unable to create a loop device; exiting ...
eof
    return 1
    fi
    DIRECT_DEVICE=$(basename ${loop_device}) _create_disk_image_proc
    local image_file_name=$(sudo losetup ${loop_device} | awk '$0=$NF')
    export L4T_IMAGE=${image_file_name}
cat << eof
    Created a disk image ${image_file_name}
eof
    loop_device=${loop_device} _create_disk_image_fini
    return 0
}

export COMPULAB_OVERLAYS=${L4T_ROOT}/compulab.d/overlays
declare -a overlays_tools=( tools/kernel_flash/l4t_flash_from_kernel.sh )

overlays_mount() {
    for _item in ${overlays_tools[@]};do
        sudo mount --bind  ${COMPULAB_OVERLAYS}/${_item} ${L4T_ROOT}/${_item}
        findmnt ${L4T_ROOT}/${_item}
    done
}

overlays_umount() {
    for _item in ${overlays_tools[@]};do
        sudo umount ${L4T_ROOT}/${_item}
    done
}

create_disk_image() {
    overlays_mount
    create_disk_image_func
    overlays_umount
}

export PC_BACKUP=${L4T_ROOT}/compulab.d/mfg/tools/backup.partclone.sh
export PC_RESTORE=${L4T_ROOT}/compulab.d/mfg/tools/restore.partclone.sh
create_partclone_backup() {
    [[ -z ${L4T_IMAGE:-""} ]] && return 2 || true
    local loop_device=$(_create_disk_image_init) && rc=$? || rc=$?
    if [[ -z ${loop_device:-""} ]];then
cat << eof
    Unable to create a loop device; exiting ...
eof
    return 1
    fi
    local partclone_folder=${L4T_PCDIR}/$(date +%Y-%m-%d_%T | tr ":" "-")
    mkdir -p ${partclone_folder}
    pushd ${partclone_folder}
    sudo device=${loop_device} ${PC_BACKUP}
    popd
    loop_device=${loop_device} _create_disk_image_fini
cat << eof
    Created a partclone folder ${partclone_folder}
    -------------------------------- -------------------------------- --------------------------------
    $(ls -al ${partclone_folder})
    -------------------------------- -------------------------------- --------------------------------
eof
}

export TEGRA234_MB1_BCT_MISC_COMMON="${L4T_ROOT}/bootloader/tegra234-mb1-bct-misc-common.dtsi"
wdt_get() {
    eval $(awk '(/enable_wdt/)&&(gsub(/[[:space:]]|<|>/,""))'  ${TEGRA234_MB1_BCT_MISC_COMMON})
    echo ${enable_wdt}
}

wdt_set() {
    [[ -n ${enable_wdt:-""} ]] || return 0
    sed -i "s/\(enable_wdt =\).*;/\1 <${enable_wdt}>;/g" ${TEGRA234_MB1_BCT_MISC_COMMON}
}

wdt_toggle() {
    declare -i enable_wdt=$(wdt_get)
    enable_wdt=$(( $(( ${enable_wdt} + 1 )) % 2 )) wdt_set
}

deploy_bootloader() {
    local cmd_file_name=/tmp/${FUNCNAME}
    bootloader_bootorder
cat << eof | tee ${cmd_file_name}
    pushd ${L4T_ROOT}
    sudo ${DEVICE_OPTIONS} ./tools/kernel_flash/l4t_initrd_flash.sh \
        -c tools/kernel_flash/flash_l4t_external.xml \
        -p "-c bootloader/generic/cfg/flash_t234_qspi.xml --no-systemimg" ${massflash_mode_opt:-""} \
        --keep --showlogs --network usb0 ${EDGE_AI} external
    popd
eof
    source ${cmd_file_name} && rc=$? || rc=$?
    return ${rc}
}

deploy_bootloader_rootfs() {
    local cmd_file_name=/tmp/${FUNCNAME}
    bootloader_bootorder
cat << eof | tee ${cmd_file_name}
    pushd ${L4T_ROOT}
    sudo ${DEVICE_OPTIONS} ./tools/kernel_flash/l4t_initrd_flash.sh \
        --external-device nvme0n1p1 \
        -c tools/kernel_flash/flash_l4t_t234_nvme.xml \
        -p "-c bootloader/generic/cfg/flash_t234_qspi.xml" ${massflash_mode_opt:-""} \
        --keep --showlogs --network usb0 ${EDGE_AI} external
    popd
eof
    source ${cmd_file_name} && rc=$? || rc=$?
    return ${rc}
}

alias ~d1="deploy_bootloader"
alias ~d2="deploy_bootloader_rootfs"

prepare_massflash_boot() {
    massflash_mode_opt="--no-flash --massflash 5" deploy_bootloader
}

prepare_massflash_boot_rootfs() {
    massflash_mode_opt="--no-flash --massflash 5" deploy_bootloader_rootfs
}

deploy_massflash() {
    pushd ${L4T_ROOT}
    sudo ./tools/kernel_flash/l4t_initrd_flash.sh \
        --flash-only --massflash 5 --network usb0 --${massflash_arg:-"keep"}
    popd
    # export massflash_arg="reuse"
}

alias ~mf="deploy_massflash"
alias ~mf1="prepare_massflash_boot"
alias ~mf2="prepare_massflash_boot_rootfs"

rootfs_sdk_snapshot() {
    local sdk_tar_file="${L4T_TMP}/sdk-rootfs-${L4T_KERNEL_VER}.tar.bz2"
    mkdir -p ${L4T_TMP}
    sudo tar -C ${INSTALL_MOD_PATH} --numeric-owner -cpjvf ${sdk_tar_file} \
            lib/modules/${L4T_KERNEL_VER} \
            boot \
            opt/compulab \
            etc/systemd/system/default.target.wants/${rootfs_service}.service \
            lib/systemd/system/${rootfs_service}.service
    sudo chown ${USER}:${USER} ${sdk_tar_file}
    stat ${sdk_tar_file}
    md5sum ${sdk_tar_file} | tee ${sdk_tar_file}.md5sum
}

l4t_compulab() {
    local sdk_tar_file="${L4T_TMP}/sdk-rootfs-${L4T_KERNEL_VER}.tar.bz2"
    local l4t_compulab="https://github.com/compulab-yokneam/compulab-l4t/archive/refs/heads/Linux_for_Tegra.tar.gz"
cat << eof | tee ${L4T_TMP}/sdk_update.sh &>/dev/null
#!/bin/bash -x

[[ -f ./nvsdkmanager_flash.sh ]] || exit 0
[[ -f ./nvsdkmanager_flash.sh.0riginal ]] && exit 0 || true

# Save original nvsdkmanager_flash.sh
mv nvsdkmanager_flash.sh nvsdkmanager_flash.sh.0riginal

# Deploy CompuLab Linux_for_Tegra files
curl -fsSL ${l4t_compulab} | tar --strip-components=1 -xz  --exclude='uefi_jetson*' --exclude='compulab-l4t.env' --exclude='compulab.d' --exclude='L4TConfiguration.dtbo'

# Update sample rootfs with the CompuLab stuff
sudo tar -C rootfs -xf ${sdk_tar_file}

echo "Update sdk is done .."

eof
    chmod a+x ${L4T_TMP}/sdk_update.sh
cat << eof

********************************************************************
* Issue this file in the NVidia Jetson SDK Linux_for_Tegra folder: *
********************************************************************

cd /path/to/nvidia_sdk/JetPack.../Linux_for_Tegra
${L4T_TMP}/sdk_update.sh

eof
}

Linux_for_Tegra_sdk() {
    rootfs_sdk_snapshot
    l4t_compulab
}

L4T_COMPULAB="https://github.com/compulab-yokneam/compulab-l4t/archive/refs/heads/Linux_for_Tegra.tar.gz"
l4t_compulab_support() {
    curl -fsSL ${L4T_COMPULAB} | tar -C ${L4T_ROOT} --strip-components=1 -xvz
}

rootfs_linux_kernel_snapshot() {
    local kernel_tar_file="${L4T_TMP}/linux-kernel-${L4T_KERNEL_VER}.tar.bz2"
    pushd ${INSTALL_MOD_PATH}
    mkdir -p ${L4T_TMP}
    sudo tar --numeric-owner --exclude="boot/extlinux" -cpjvf ${kernel_tar_file} lib/modules/${L4T_KERNEL_VER}  boot
    sudo chown ${USER}:${USER} ${kernel_tar_file}
    popd
    stat ${kernel_tar_file}
    md5sum ${kernel_tar_file} | tee ${kernel_tar_file}.md5sum
}

rootfs_linux_firmware_snapshot() {
    local firmware_tar_file="${L4T_TMP}/linux-firmware-${L4T_KERNEL_VER}.tar.bz2"
    pushd ${INSTALL_MOD_PATH}
    mkdir -p ${L4T_TMP}
    sudo tar --numeric-owner -cpjf ${firmware_tar_file} lib/firmware
    sudo chown ${USER}:${USER} ${firmware_tar_file}
    popd
    stat ${firmware_tar_file}
    md5sum ${firmware_tar_file} | tee ${firmware_tar_file}.md5sum
}

alias ~sk="rootfs_linux_kernel_snapshot"
alias ~sf="rootfs_linux_firmware_snapshot"
alias ?="alias"

recovery_shell() {
    local flash_cmd=${MFI_BOOTLOADER}/flashcmd.txt
    pushd ${MFI_BOOTLOADER} > /dev/null
    sed 's/boot.img/boot0.img/' ${flash_cmd} | sudo tee ${flash_cmd}0 &>/dev/null
    sudo bash -x ${flash_cmd}0
    popd > /dev/null
}

declare -xA deployment_config=( ['bootloader']=logo ['command']=deploy_bootloader )
CLERP_CMD=${L4T_ROOT}/compulab.d/mfg/clerp

function deployment_set_status() {
    STATUS=${STATUS:-"zero state deployment"}
cat << eof
    ${CLERP_CMD} ${SERIAL} ${STATUS}
eof
}

function deployment_read_serial() {
    local _SERIAL
    read -p " Serial number > " _SERIAL
    export SERIAL=${_SERIAL}
}

function deployment_get_config() {
    deployment_read_serial
    eval $(${CLERP_CMD} get_config ${SERIAL})
}

function deployment_read_config() {
    local _CONFIG
    read -p " Config string > " _CONFIG
    export CONFIG=${_CONFIG}
}

function deployment_config_CNX16() {
    dev_type=${FUNCNAME/deployment_config_C/} select_device
}

function deployment_config_CNX8() {
    dev_type=${FUNCNAME/deployment_config_C/} select_device
}

function deployment_config_CNA4() {
    dev_type=${FUNCNAME/deployment_config_C/} select_device
}

function deployment_config_CNA8() {
    dev_type=${FUNCNAME/deployment_config_C/} select_device
}

function deployment_config_BN() {
    deployment_config['bootloader']=nologo
}

# uncomment the next line for the JetPack deployment
# export allow_config_x='yes'
function deployment_config_XJP62() {
    [[ ${allow_config_x:-""} = 'yes' ]] || return 0
    deployment_config['command']=deploy_bootloader_rootfs
}

function deployment_apply_config() {
    for C in $(sed 's/-/ /g' <<<  ${CONFIG});do
        command -v deployment_config_${C} && deployment_config_${C} || true
    done
}

function deployment_main() {
    bl_type=${deployment_config['bootloader']} select_bootloader
    ${deployment_config['command']}
}

function mfg_deployment() {
    unset CONFIG SERIAL PRRODUCT
    deployment_get_config
    if [ -z ${CONFIG:-""} ];then
cat << eof
    Unable to get config for this serial # ${SERIAL}
eof
    return 22
    fi
    deployment_apply_config
    deployment_main && STATUS="success" || STATUS="failed"
    STATUS=${STATUS} deployment_set_status
}
declare -x simple_shell_functions="deploy_bootloader deploy_bootloader_rootfs mfg_deployment"

__add_entry() {
    local func_name=${1}
    configs+=([${entry_number}_${func_name}]=${func_name})
    ((entry_number++))
}

_add_entry() {
    if [ -n ${simple_shell_enabled:-""} ];then
        [[ ${simple_shell_functions} =~ "${1}" ]] && __add_entry $@
        return 0
    fi
    __add_entry $@
}

export devshell_history=""
function show_history() {
cat << eof
....................................
eof
    for _entry in ${devshell_history};do
        echo ${_entry}
    done
cat << eof
....................................
eof
}

function exit_devshell() {
    run_devshell=0
}

_devshell() {
    declare -xi entry_number=1
    declare -xA configs=()

    if [[ -n ${ROOTFS:-""} ]];then
    _add_entry "update_rootfs"
    fi
    _add_entry "compile_all"
    if [[ -n ${ROOTFS:-""} ]];then
        _add_entry "install_all"
        _add_entry "post_install_update"
        _add_entry "do_it_all"
        _add_entry "Linux_for_Tegra_sdk"
        _add_entry "rootfs_linux_kernel_snapshot"
        _add_entry "customize_rootfs"
    fi

    _add_entry "wdt_toggle"
    _add_entry "select_config"
    _add_entry "select_device"
    _add_entry "select_bootloader"

    if [ ! ${BOARDSKU} = "-1"  ];then
        _add_entry "prepare_massflash_boot"
        _add_entry "prepare_massflash_boot_rootfs"
    fi

    if [ ${NVIDIA_DEVS} -gt 0 ];then
        _add_entry "deploy_bootloader"
        _add_entry "deploy_bootloader_rootfs"
        _add_entry "prepare_massflash_boot"
        _add_entry "prepare_massflash_boot_rootfs"
        _add_entry "deploy_massflash"
        _add_entry "mfg_deployment"
        if [ -d ${MFI_BOOTLOADER} ];then
            _add_entry "recovery_shell"
        fi
        _add_entry "backup_rootfs_bootloader"
        if [ -f ${RES_BOOTLOADER} ];then
            _add_entry "restore_rootfs_bootloader"
        fi
    fi
    _add_entry "create_disk_image"
    _add_entry "create_partclone_backup"
    _add_entry "l4t_compulab_support"
    _add_entry "show_history"
    _add_entry "exit_devshell"

    local select_string=$(echo -n ${!configs[@]} | tr ' ' '\n' | sort -n | tr '\n' ' ')
    PS3="CompuLab Nvidia devshell (Ctrl^C -- exit) ; ( conf=${EDGE_AI}; bootloader=$(current_bootloader); wdt=$(wdt_get); ) ; ( device=$(current_device) ) ; ( kernel# $(__compiled_k_version) ) ; ( dev# ${NVIDIA_DEVS} ) > "
    select i in ${select_string}; do
        case ${i} in
        "")
            break
            ;;
        *)
            function_to_issue=${configs[${i}]}
            [[ ${function_to_issue} = "show_history" ]] || devshell_history+="${function_to_issue} "
            ${function_to_issue}
            break
            ;;
        esac
    done
}

is_simple_shell_available() {
    [[ ${NVIDIA_DEVS} -gt 0 ]] && return 0 || true
cat << eof
    Detected ${NVIDIA_DEVS} devices
    simple_shell is not available
eof
    return 1
}

export run_devshell=
devshell() {
    unset bl_type
    run_devshell=1
    while [ ${run_devshell} ];do
        [[ ${run_devshell} -eq 1 ]] || break
        NVIDIA_DEVS=$(lsusb | awk '/NVIDIA Corp. APX/' | wc -l)
        if [[ -n ${simple_shell_enabled:-""} ]];then
            is_simple_shell_available || return 0
        fi
        _devshell
    done;
}

simple_shell() {
    unset simple_shell_enabled
    declare -x simple_shell_enabled=""
    simple_shell_enabled="yes"
    devshell
    simple_shell_enabled=""
}

alias ~?="devshell"

issue_recovery_shell() {
    local FLASH_CMD=${MFI_BOOTLOADER}/flashcmd.txt
    sed 's/boot.img/boot0.img/' ${FLASH_CMD} > ${FLASH_CMD}0
    sudo bash -x ${FLASH_CMD}0
}

cat << eof
**********************************
* devshell       -- development shell
* simple_shell   -- user shell
* mfg_deployment -- flashing bootloader
***********************************
eof
