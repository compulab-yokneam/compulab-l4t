_BASH_SOURCE=${BASH_SOURCE[0]}
_WORK_DIR=$(dirname $(readlink -e ${BASH_SOURCE[0]}))

_DISK_LAYOUT=${src_dir}/disk.layout
_APP_SIZE=0
declare -A layout_array

layout_array["layout_01"]="01_Nvidia Layout (DEFAULT); rootfs till the end of the media"
layout_01() {
    _APP_SIZE=0
}

_layout_with_size() {
    _APP_SIZE=${app_size}
    _update_layout() {
        wait 1
        add_swap
        wait 1
        part_label=${data_part_name} add_ext4
        wait 1
        partprobe ${device}
        wait 1
    }
}

layout_array["layout_02"]="02_Nvidia Layout; rootfs=<user_defined_>GiB, swap=16GiB, data partition till the end of the media"
layout_02() {
    local select_string="32 64 128 Exit"
    local app_size=""
    PS3="Choose rootfs size > "
    while [ -z ${app_size:-""} ];do
        select j in ${select_string}; do
            case ${j} in
                "Exit")
                exit 0
                ;;
                *)
                app_size=${j}
                break
                ;;
            esac
        done
    done
    app_size=${app_size} _layout_with_size
}

apply_layout() {
    local REAL_SIZE=$(( ${_APP_SIZE}  << 21 ))
    [[ ${REAL_SIZE} -eq 0 ]] && REAL_SIZE=""
    sed "s/@@SIZE@@/${REAL_SIZE}/g" ${_DISK_LAYOUT} | tee ${WORKING_LAYOUT}
}

WORKING_LAYOUT=/tmp/disk.layout

inst_init() {
    # Umount the file; it could be mounted; after a failed run
    while [ 1 ];do
        umount ${src_dir}/disk.layout &>/dev/null || break
    done
    apply_layout
    mount -B ${WORKING_LAYOUT} ${src_dir}/disk.layout
}

# After APP
add_swap() {
    local after=${after:-"root"}
    local part_size_gb=${part_size_gb:-16}
    local part=$(get_partition_by_name ${after})
    [[ -n ${part:-""} ]] || return 22
    part=$(basename ${part})
    local edge_block=$(( $(cat /sys/class/block/${part}/start) + $(cat /sys/class/block/${part}/size) ))
    # roud up
    local part_start_mb=$(( $(( $(( $(( ${edge_block} >> 11 )) + 4 )) / 4 )) * 4 ))
    local part_stop_mb=$(( ${part_start_mb} + $(( ${part_size_gb} << 10 )) ))
    echo "mkpart swap linux-swap ${part_start_mb}MiB ${part_stop_mb}MiB" | parted ${device}
}

# After swap
add_ext4() {
    local after=${after:-"swap"}
    local part_size_gb=${part_size_gb:-16}
    local part_label=${part_label:-"part_label"}
    local part=$(get_partition_by_name ${after})
    [[ -n ${part:-""} ]] || return 22
    part=$(basename ${part})
    local edge_block=$(( $(cat /sys/class/block/${part}/start) + $(cat /sys/class/block/${part}/size) ))
    # roud up
    local part_start_mb=$(( $(( $(( $(( ${edge_block} >> 11 )) + 4 )) / 4 )) * 4 ))
    local part_stop_mb=$(( ${part_start_mb} + $(( ${part_size_gb} << 10 )) ))
    echo "mkpart ${part_label} ext4 ${part_start_mb}MiB ${part_stop_mb}MiB" | parted ${device}
}

data_part_name="storage"

_inst_fini1() {
    command -v _update_layout >/dev/null &&  _update_layout
    umount ${src_dir}/disk.layout
    local rootfs_partition=$(get_partition_by_name "root")
    [[ -n ${rootfs_partition:-""} ]] || return 22
    # part=${rootfs_partition} expand_partition

    declare -A fstab_array
    local swap_partition=$(get_partition_by_name "swap")
    if [[ -n ${swap_partition:-""} ]];then
        mkswap ${swap_partition}
        fstab_array["swap"]="/dev/disk/by-partlabel/swap none swap sw 0 0"
    fi

    local storage_partition=$(get_partition_by_name ${data_part_name})
    if [[ -n ${storage_partition:-""} ]];then
        mkfs.ext4 -F -L ${data_part_name} ${storage_partition}
        part=${storage_partition} expand_partition
        fstab_array[${data_part_name}]="/dev/disk/by-partlabel/${data_part_name} /${data_part_name} ext4 defaults 0 0"
    fi

    # Update fstab if required
    [[ ${#fstab_array[@]} -eq 0 ]] && return 0

    local rootfs_mpoint=$(mktemp --directory)
    mount ${rootfs_partition} ${rootfs_mpoint}
    for _fstab in ${!fstab_array[@]};do
        echo ${fstab_array[${_fstab}]} | tee &>/dev/null -a ${rootfs_mpoint}/etc/fstab
    done
    umount ${rootfs_partition}
    rm -rf ${rootfs_mpoint}
}

_extlinux_update() {
    rootfs_mpoint=${rootfs_mpoint} chroot_cmd=/opt/compulab/init.d/05-boot.sh issue_chroot
}

_initrd_update() {
    chmod a+x ${rootfs_mpoint}/opt/compulab/update_initrd.sh
    rootfs_mpoint=${rootfs_mpoint} chroot_cmd=/opt/compulab/update_initrd.sh issue_chroot
}

_rootfs_apt() {
    [[ -n "$@" ]] || return 0
    local chroot_apt_cmd=/tmp/apt.sh
cat << eof | tee &>/dev/null ${rootfs_mpoint}/${chroot_apt_cmd}
    export DEBIAN_FRONTEND=noninteractive
    apt-get install --yes $@
eof
    chmod a+x ${rootfs_mpoint}/${chroot_apt_cmd}
    rootfs_mpoint=${rootfs_mpoint} chroot_cmd=${chroot_apt_cmd} issue_chroot
    rm -rf ${rootfs_mpoint}/${chroot_apt_cmd}
}

declare -A partname_to_enc_volume_name=(['root']='root')
_create_enc_volume() {
    [[ -n ${part_name:-""} ]] || return 22

    local volume_part=$(get_partition_by_name ${part_name})

    if [[ -z ${volume_part:-""} ]];then
        echo "No partition for ${part_name}; error  ..."
        return 22
     fi

    local volume_name=${partname_to_enc_volume_name[${part_name}]:-${part_name}}

    dd if=/dev/urandom of=${tmp_root}/etc/keys/${volume_name}.key bs=1 count=4096
    echo "YES" | cryptsetup -c aes-xts-plain64 -s 512 -y luksFormat ${volume_part} ${tmp_root}/etc/keys/${volume_name}.key

    cryptsetup luksOpen -d ${tmp_root}/etc/keys/${volume_name}.key ${volume_part} ${volume_name}

    # Deploy partclone image if exists; mkfs if does not
    local part_number=$(cat /sys/class/block/$(basename ${volume_part})/partition)
    local image=$(ls ${src_dir}/part${part_number}.*)

    if [[ -z ${image:-""} ]];then
        mkfs.ext4 -L ${volume_name} /dev/mapper/${volume_name}
    else
        partclone.restore -C -d -s ${image} -o /dev/mapper/${volume_name}
    fi

    cryptsetup luksClose ${volume_name} || true

    unset ID_FS_UUID
    eval $(udevadm info -x --query=property ${volume_part})
# Update the crypttab file with the encrypted volume info
cat << eof | tee -a ${tmp_root}/etc/crypttab
${volume_name} UUID=${ID_FS_UUID} /etc/keys/${volume_name}.key luks,initramfs
eof
}

_system_enc() {
    # prepare tmp rootfs stuff
    export tmp_root=$(mktemp --directory)
    cp -a ${rootfs_dir}/* ${tmp_root}
    part_name="root" _create_enc_volume
}

_inst_fini0() {
    local part_name='root'
    local rootfs_part=$(get_partition_by_name ${part_name})
    local volume_close="true"
    local rootfs_append=""

    unset ID_FS_TYPE
    eval $(udevadm info -x --query=property ${rootfs_part})
    if [[ ${ID_FS_TYPE:-""} = "crypto_LUKS" ]];then
        local volume_name=${partname_to_enc_volume_name[${part_name}]:-${part_name}}
        cryptsetup luksOpen -d ${tmp_root}/etc/keys/${volume_name}.key ${rootfs_part} ${volume_name}
        volume_close="cryptsetup luksClose ${volume_name}"
        rootfs_part=/dev/mapper/${volume_name}
        rootfs_append="cryptdevice=UUID=${ID_FS_UUID}:root root=/dev/mapper/root"
    fi

    local rootfs_mpoint=$(mktemp --directory)
    mount ${rootfs_part} ${rootfs_mpoint}

    # Install required packages
    rootfs_mpoint=${rootfs_mpoint} _rootfs_apt cryptsetup-initramfs

    # Update boot configuration on the original rootfs
    rootfs_mpoint=${rootfs_mpoint} _extlinux_update

    # Update root device if required
    if [[ -n ${rootfs_append:-""} ]];then
        local extlinux_conf_file=${rootfs_mpoint}/boot/extlinux/extlinux.conf
        cp ${extlinux_conf_file} ${extlinux_conf_file}.0riginal
        sed -i "s|root=[^[:space:]]*[[:space:]]|${rootfs_append} |g" ${extlinux_conf_file}
        tar -C ${tmp_root} -cf - . | tar -C ${rootfs_mpoint} -xf -
    fi

    # Update initrd
    rootfs_mpoint=${rootfs_mpoint} _initrd_update

    # Prepare APP partition for boot files only
    local app_part=$(get_partition_by_name APP)
    local app_mpoint=$(mktemp --directory)
    mkfs.ext4 -FL APP ${app_part}
    mount ${app_part} ${app_mpoint}

    # Copy rootfs/boot to <boot-partition>/
    cp -a ${rootfs_mpoint}/boot ${app_mpoint}/
    umount ${app_mpoint} ${rootfs_mpoint}
    ${volume_close}
}

inst_fini() {
    _system_enc
    _inst_fini0
    _inst_fini1
}
