_BASH_SOURCE=${BASH_SOURCE[0]}
_WORK_DIR=$(dirname $(readlink -e ${BASH_SOURCE[0]}))
_DISK_LAYOUT=${_WORK_DIR}/disk.layout
_ETC_FSTAB=${_WORK_DIR}/fstab

inst_init() {
cat << eof
	Issue: $(readlink -e ${_BASH_SOURCE}): $FUNCNAME
eof
	mount -B ${_DISK_LAYOUT} ${src_dir}/disk.layout
}

inst_fini() {
cat << eof
	Issue: $(readlink -e ${_BASH_SOURCE}): $FUNCNAME
eof
	umount ${src_dir}/disk.layout
# Update the rootfs /etc/fstab
	local rootfs_partition=$(get_partition_by_name "APP")
	[[ -n ${rootfs_partition:-""} ]] || return 22
	local rootfs_mpoint=$(mktemp --directory)
	mount ${rootfs_partition} ${rootfs_mpoint}
	cp -v ${_ETC_FSTAB} ${rootfs_mpoint}/etc/fstab
	umount ${rootfs_partition}
	rm -rf ${rootfs_mpoint}
}
